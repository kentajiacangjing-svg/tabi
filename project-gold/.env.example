# ---- アプリ（クライアントに埋め込まれる公開値のみ。秘密鍵は絶対に書かない）----
# ローカル開発サーバー: `npm run dev:env` で .env.local が自動生成されます
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# on: Supabase Realtime で新着を購読 / off: ポーリング（ローカル開発サーバーは off）
EXPO_PUBLIC_REALTIME=on
# 招待リンクの公開URL（未設定なら Web は現在のドメイン、アプリは projectgold:// スキーム）
EXPO_PUBLIC_SITE_URL=
# デモアカウントのワンタップログインを本番ビルドで表示する場合のみ on（通常は空）
EXPO_PUBLIC_SHOW_DEMO_LOGIN=

# ---- サーバー専用（Supabase のダッシュボード / `supabase secrets set` で設定。.env にコミットしない）----
# SUPABASE_SERVICE_ROLE_KEY=        # scripts/seed-storage.mjs・Edge Functions 用
# PAYMENT_PROVIDER=                 # 決済事業者の審査・契約後に設定（例: revenuecat / stripe）
# PAYMENT_WEBHOOK_SECRET=           # 同上

# ---- ローカル開発サーバー（任意）----
# DEV_API_PORT=54321
# DEV_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
