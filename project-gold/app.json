{
  "expo": {
    "name": "PROJECT GOLD",
    "slug": "project-gold",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "projectgold",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F6",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.example.projectgold",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "プロフィール写真を登録するために写真ライブラリへアクセスします。"
      }
    },
    "android": {
      "package": "com.example.projectgold",
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "PROJECT GOLD",
      "themeColor": "#FAF9F6",
      "backgroundColor": "#FAF9F6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真を登録するために写真ライブラリへアクセスします。",
          "cameraPermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
