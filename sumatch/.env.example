# SQLite のファイルとアップロードの保存先（既定: ./storage）
STORAGE_DIR=./storage
# デモモード: サンプルの会社・お客様・口コミ・写真と、ワンクリックのデモログイン。
# 未設定なら 開発=オン / 本番ビルド(npm start)=オフ。本番でデモを見せる時だけ true にする。
DEMO_MODE=true
# 連絡先・訪問先住所の暗号化キー（32バイトをbase64。例: openssl rand -base64 32）。本番では必須。
# 交換する時は古いキーを DATA_ENCRYPTION_KEYS_OLD（カンマ区切り）へ。値はリポジトリに書かないこと。
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEYS_OLD=
# AIの返信下書き: 既定はオフ。true にした時だけ（ANTHROPIC_API_KEY も必要）、伏せ字にした会話を外部APIに送る
AI_DRAFT_ENABLED=
# 通知メールの送信方法: 未設定=送らない（キューに記録のみ） / mock=STORAGE_DIR/mail-sandbox.jsonl に書き出す（検証用）
MAIL_TRANSPORT=
# デモモードでない時の最初の運営アカウント（運営が1人もいない時だけ作成。12文字以上）
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 任意: 設定するとチャットの「AI返信下書き」が Claude API を使う（未設定時はテンプレートで下書き）
ANTHROPIC_API_KEY=
# 任意: /api/cron/reminders を叩くための秘密鍵
CRON_SECRET=
# 公開URL（メール本文のリンク生成に使用）
APP_URL=http://localhost:3100
# 限定テスト中のサイト全体のパスワード（「ユーザー名:パスワード」）。設定中は検索エンジンにも載らない
SITE_BASIC_AUTH=
# 前段のプロキシ（ロードバランサー）の数。ログインの回数制限で接続元を判定するために使う。直接公開なら 0
TRUST_PROXY_HOPS=1
# true で検索エンジンに載せない（SITE_BASIC_AUTH 設定中は自動）
ROBOTS_NOINDEX=
# npm run db:backup の保存先（既定: ./backups）
BACKUP_DIR=
# 接続元の判定に使うヘッダー（Cloudflare トンネル経由のみで到達できる時に cf-connecting-ip。npm run demo:share が設定）
CLIENT_IP_HEADER=
# off でリアルタイム配信（SSE）を使わない（Quick Tunnel は SSE 非対応。チャットは20秒ごとに更新）
REALTIME_STREAM=
# npm run demo:share が表示する cloudflared コマンドに --allowed-mail として入れるメールアドレス（カンマ区切り）
TUNNEL_ALLOWED_EMAILS=
